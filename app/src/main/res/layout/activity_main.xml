<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_collapseMode="pin"
            app:title="@string/app_name"
            app:titleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:ignore="SpeakableTextPresentCheck">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/option_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/glsl_cache_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@+id/text_option_angle">

                <TextView
                    android:id="@+id/text_option_glsl_cache"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:text="@string/option_glsl_cache" />

                <TextView
                    android:id="@+id/text_glsl_cache_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="32 MB" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 取值范围是滑块「档位」而不是 MB：MB 由几何刻度换算，见 MainActivity。 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_glsl_cache"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/option_glsl_cache"
                        android:stepSize="1.0"
                        android:valueFrom="0.0"
                        android:valueTo="200.0"
                        app:labelBehavior="gone"
                        app:tickVisible="false" />

                    <TextView
                        android:id="@+id/text_glsl_cache_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="5dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        tools:text="3025 MB" />

                </LinearLayout>

                <!-- 仅在「缓存已关闭且缓存文件仍存在」时出现，见 MainActivity.renderGlslCacheDeleteButton -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_clear_glsl_cache"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    tools:text="删除已缓存的着色器（12.3 MiB）"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_option_angle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/option_angle"
                app:layout_constraintBottom_toTopOf="@+id/spinner_angle"
                app:layout_constraintStart_toStartOf="parent" />

            <Spinner
                android:id="@+id/spinner_angle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:minHeight="48dp"
                app:layout_constraintBottom_toTopOf="@+id/text_option_no_error" />

            <TextView
                android:id="@+id/text_option_no_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/option_no_error"
                app:layout_constraintBottom_toTopOf="@+id/spinner_no_error"
                app:layout_constraintStart_toStartOf="parent" />

            <Spinner
                android:id="@+id/spinner_no_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:minHeight="48dp"
                app:layout_constraintBottom_toTopOf="@+id/multidraw_section" />

            <!--
                MultiDraw 后端：native 现在是「每个入口点一个键」，共 5 个入口点外加一份全局停用名单。
                这属于高级选项，绝大多数人应当保持自动，所以整块默认折叠，只在标题行给出一句话摘要。
                行与筹码都由枚举生成（见 MainActivity.setupMultidraw），布局里只留容器。
            -->
            <LinearLayout
                android:id="@+id/multidraw_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@+id/text_option_gl_version">

                <LinearLayout
                    android:id="@+id/multidraw_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/option_multidraw" />

                        <TextView
                            android:id="@+id/text_multidraw_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            tools:text="全部自动" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/icon_multidraw_expand"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/option_multidraw"
                        android:src="@drawable/ic_expand_more_24" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/multidraw_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/multidraw_entries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/option_multidraw_disable" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/option_multidraw_disable_helper"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chips_multidraw_disabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="5dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/text_option_gl_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/option_custom_gl_version"
                app:layout_constraintBottom_toTopOf="@+id/spinner_custom_gl_version"
                app:layout_constraintStart_toStartOf="parent" />

            <Spinner
                android:id="@+id/spinner_custom_gl_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:minHeight="48dp"
                app:layout_constraintBottom_toTopOf="@+id/text_angle_clear_workaround" />

            <TextView
                android:id="@+id/text_angle_clear_workaround"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/option_angle_clear_workaround"
                app:layout_constraintBottom_toTopOf="@+id/angle_clear_workaround"
                app:layout_constraintStart_toStartOf="parent" />

            <Spinner
                android:id="@+id/angle_clear_workaround"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:minHeight="48dp"
                app:layout_constraintBottom_toTopOf="@+id/switch_ext_cs" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_ext_cs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/option_ext_cs"
                app:layout_constraintBottom_toTopOf="@+id/switch_ext_timer_query" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_ext_timer_query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/option_ext_timer_query"
                app:layout_constraintBottom_toTopOf="@+id/switch_ext_direct_state_access" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_ext_direct_state_access"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/option_ext_direct_state_access"
                app:layout_constraintBottom_toTopOf="@id/switch_enable_fsr1"/>
            
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_enable_fsr1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/option_enable_fsr1"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/open_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="6dp"
        android:text="@string/open_options" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>